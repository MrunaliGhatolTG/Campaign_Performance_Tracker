# This app runs on sample data by default, with no backend.
# Everything below only matters once you have the FastAPI service.

# 1 = call the real API instead of the built-in sample data.
# `npm run dev:api` sets this for you via .env.api.
VITE_API=0

# Where the dev server proxies /api. Defaults to http://127.0.0.1:8000.
VITE_API_TARGET=http://127.0.0.1:8000

# Only set this if the API is on a different origin in the browser.
VITE_API_BASE=
