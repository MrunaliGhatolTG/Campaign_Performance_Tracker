# SMTP for the morning brief. Copy to .env and run:
#
#     uvicorn app.main:app --env-file .env
#
# With SMTP_HOST unset nothing is sent: /api/digest/status reports
# "configured": false and the scheduler records why rather than failing quietly.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURITY=starttls          # starttls | ssl | none
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=                  # an app password if the tenant enforces MFA
SMTP_FROM=alerts@yourcompany.com
SMTP_FROM_NAME=Campaign Performance Tracker
SMTP_TIMEOUT=30

# How late a missed slot may still go out, in minutes. Past this the day is
# treated as missed instead of sending a "morning" brief at midnight.
DIGEST_CATCHUP_MINUTES=120
